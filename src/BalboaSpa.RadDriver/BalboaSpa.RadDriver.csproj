<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net47</TargetFramework>
    <AssemblyName>BalboaSpa.RadDriver</AssemblyName>
    <RootNamespace>BalboaSpa.RadDriver</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Crestron's SDK 29 NuGet packages supply the RAD V1 and SIMPL# references.
       ManifestUtil runs as an MSBuild packaging target after compilation. -->
  <ItemGroup>
    <PackageReference Include="Crestron.DeviceDrivers.DevKit" Version="29.0.10" />
    <PackageReference Include="Crestron.DeviceDrivers.ManifestUtil" Version="29.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\BalboaSpa.Protocol\BalboaCommands.cs" Link="Protocol\BalboaCommands.cs" />
    <Compile Include="..\BalboaSpa.Protocol\BalboaConnectionOptions.cs" Link="Protocol\BalboaConnectionOptions.cs" />
    <Compile Include="..\BalboaSpa.Protocol\BalboaFrame.cs" Link="Protocol\BalboaFrame.cs" />
    <Compile Include="..\BalboaSpa.Protocol\BalboaFrameCodec.cs" Link="Protocol\BalboaFrameCodec.cs" />
    <Compile Include="..\BalboaSpa.Protocol\BalboaMessageType.cs" Link="Protocol\BalboaMessageType.cs" />
    <Compile Include="..\BalboaSpa.Protocol\BalboaSpaStatus.cs" Link="Protocol\BalboaSpaStatus.cs" />
    <EmbeddedResource Include="BalboaPoolController.json" />
  </ItemGroup>
</Project>
