<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>BalboaSpa.Driver</RootNamespace>
    <AssemblyName>BalboaSpaDriver</AssemblyName>
    <TargetFramework>net47</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="mscorlib" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <PackageReference Include="Crestron.DeviceDrivers.DevKit" Version="$(CrestronSdkPackageVersion)" />
    <PackageReference Include="Crestron.DeviceDrivers.ManifestUtil" Version="$(CrestronSdkPackageVersion)" PrivateAssets="all" />
    <ProjectReference Include="..\BalboaSpa.Protocol\BalboaSpa.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="BalboaSpaDriver.json" />
    <None Update="IncludeInPkg\Translations\en-US.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="IncludeInPkg\UiDefinitions\BalboaSpa.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
